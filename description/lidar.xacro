<?xml version="1.0"?>
<xacro:macro name="lidar_setup" params="" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <joint name="servo_joint" type="continuous">
    <parent link="chassis"/>
    <child link="servo_link"/>
    <origin xyz="0.0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="servo_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="servo_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>

</xacro:macro>
