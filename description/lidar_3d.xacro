<?xml version="1.0"?>
<robot name="lidar_lib" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar_setup" params="parent:=top_plate
                                          servo_link:=servo_link
                                          laser_frame:=laser_frame">

    <material name="lidar_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    <material name="lidar_gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
    <material name="lidar_blue"><color rgba="0.2 0.5 1.0 1.0"/></material>

    <joint name="lidar_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_mount"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

    <link name="lidar_mount">
      <visual>
        <geometry><box size="0.05 0.05 0.04"/></geometry>
        <material name="lidar_gray"/>
      </visual>
      <collision>
        <geometry><box size="0.05 0.05 0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
      </inertial>
    </link>

    <joint name="servo_joint" type="continuous">
      <parent link="lidar_mount"/>
      <child link="${servo_link}"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/> 
    </joint>

    <link name="${servo_link}">
      <visual>
        <origin xyz="0 0 0.0175" rpy="0 0 0"/>
        <geometry><cylinder radius="0.008" length="0.035"/></geometry>
        <material name="lidar_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.0175" rpy="0 0 0"/>
        <geometry><cylinder radius="0.008" length="0.035"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="${servo_link}"/>
      <child link="${laser_frame}"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>

    <link name="${laser_frame}">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.04" length="0.05"/></geometry>
        <material name="lidar_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.041" length="0.0015"/></geometry>
        <material name="lidar_blue"/>
      </visual>

      <inertial>
        <mass value="0.25"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>
